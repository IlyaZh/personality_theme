<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <title>{{@site.title}} - {{@site.description}}</title>
    <meta name="description" content="{{@site.description}}">
     {{!-- Theme styles --}}
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
   
    
    {{!-- Favicon --}}
    {{#if @custom.favicon}}
    <link rel="icon" href="{{img_url @custom.favicon}}">
    {{else}}
    <link rel="icon" type="image/svg+xml" href="{{asset 'favicon.svg'}}">
    {{/if}}
    
    {{!-- Ghost head --}}
    {{ghost_head}}
    {{!-- <style>
        .hero-gradient {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #8b5cf6 100%);
        }
        .card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
    </style> --}}
</head>
<body class="min-h-screen bg-base-100 overflow-x-hidden">
    {{!-- Announcement Bar --}}
    {{> announcement}}
    
    <!-- Navigation -->
    <div class="navbar bg-base-100 shadow-lg sticky top-0 z-50">
        <div class="navbar-start">
            <div class="dropdown">
                <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"></path>
                    </svg>
                </div>
                <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
                    <li><a href="#about">About</a></li>
                    <li><a href="#skills">Skills</a></li>
                    <li><a href="#experience">Experience</a></li>
                    <li><a href="#contact">Contact</a></li>
                    <li><a href="{{@site.url}}/blog/">Blog</a></li>
                    <li class="border-t pt-2 mt-2">
                        <a href="{{@custom.resume_link}}" target="_blank" class="text-primary">
                            <i class="fas fa-download mr-2"></i>
                            Download Resume
                        </a>
                    </li>
                </ul>
            </div>
            <a href="{{@site.url}}" class="btn btn-ghost text-xl font-bold">{{@site.title}}</a>
        </div>
        
        <div class="navbar-center hidden lg:flex">
            <ul class="menu menu-horizontal px-1">
                <li><a href="#about" class="hover:text-primary">About</a></li>
                <li><a href="#skills" class="hover:text-primary">Skills</a></li>
                <li><a href="#experience" class="hover:text-primary">Experience</a></li>
                <li><a href="#contact" class="hover:text-primary">Contact</a></li>
                <li><a href="{{@site.url}}/blog/" class="hover:text-primary">Blog</a></li>
            </ul>
        </div>
        
        <div class="navbar-end">
            <a href="{{@custom.resume_link}}" target="_blank" class="btn btn-primary btn-sm mr-2 hidden lg:flex">
                <i class="fas fa-download mr-2"></i>
                Resume
            </a>
            <button class="btn btn-ghost btn-circle" id="theme-toggle">
                <i class="fas fa-moon text-xl" id="theme-icon"></i>
            </button>
        </div>
    </div>

    <!-- Hero Section -->
    <section class="hero min-h-[80vh] hero-gradient text-white">
        <div class="hero-content text-center">
            <div class="max-w-md">
                <div class="avatar mb-8">
                    <div class="w-48 rounded-full ring ring-white ring-offset-base-100 ring-offset-2">
                        {{#if @custom.personal_photo}}
                            <img src="{{img_url @custom.personal_photo size="m"}}" alt="{{@custom.personal_name}}" />
                        {{else}}
                            <img src="{{asset 'images/profile.png'}}" alt="{{@custom.personal_name}}" />
                        {{/if}}
                    </div>
                </div>
                <h1 class="text-5xl font-bold mb-4">{{@custom.personal_name}}</h1>
                <p class="text-xl mb-2">{{@custom.personal_title}}</p>
                <p class="text-lg opacity-90 mb-8"><% hero.points.forEach(function(point, index) { %><% if (index > 0) { %> • <% } %><%= point %><% }); %></p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-md mx-auto">
                    <a href="#contact" class="btn btn-primary btn-lg w-full sm:w-auto">Get in Touch</a>
                    <a href="{{@custom.resume_link}}" target="_blank" class="btn btn-outline btn-lg text-white border-white hover:bg-white hover:text-primary w-full sm:w-auto">
                        <i class="fas fa-download mr-2"></i>
                        Download Resume
                    </a>
                </div>
                <div class="mt-4">
                    <a href="#experience" class="btn btn-ghost btn-sm text-white/80 hover:text-white">
                        <i class="fas fa-chevron-down mr-2"></i>
                        View My Experience
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-20 bg-base-100">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16 text-base-content">About Me</h2>
            <div class="grid lg:grid-cols-2 gap-12 items-start">
                <div class="space-y-6"><% about.description.forEach(function(paragraph) { %>
                    <p class="text-lg text-base-content/80 leading-relaxed">
                        <%= paragraph %>
                    </p><%});%>
                    <div class="flex flex-wrap gap-4"><% about.tags.forEach(function(tag) { %>
                        <div class="badge badge-lg badge-<%= tag.style %> badge-outline"><%= tag.label %></div><%});%>
                    </div>
                </div>
                <div class="flex items-center justify-center lg:justify-end w-full">
                    <div class="stats stats-vertical shadow w-full max-w-[calc(100vw-2rem)] sm:max-w-md"><% about.stats.forEach(function (stat) {%>
                        <div class="stat px-3 sm:px-6 py-2.5 sm:py-4">
                            <div class="stat-figure text-<%= stat.color %>">
                                <i class="fas <%= stat.icon %> text-base xs:text-lg sm:text-xl md:text-2xl lg:text-3xl"></i>
                            </div>
                            <div class="stat-title text-[10px] xs:text-xs sm:text-sm"><%= stat.label %></div>
                            <div class="stat-value text-<%= stat.color %> text-base xs:text-lg sm:text-xl md:text-2xl lg:text-3xl xl:text-4xl"><%= stat.value %></div>
                        </div><%});%>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-20 bg-base-200">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16 text-base-content">Skills</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8"><% skills.forEach(function(skill) { %>
                <div class="card bg-base-100 shadow-xl card-hover">
                    <div class="card-body text-center">
                        <i class="fas <%= skill.icon %> text-4xl text-slate-600 mb-4"></i>
                        <h3 class="card-title justify-center"><%= skill.title %></h3>
                        <p><%= skill.text %></p>
                        <div class="card-actions justify-center mt-4"><% skill.tags.forEach(function(tag) { %>
                            <div class="badge badge-outline badge-<%= tag.style %>"><%= tag.label %></div><%});%>
                        </div>
                    </div>
                </div><%});%>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="py-20 bg-base-100">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16 text-base-content">Professional Experience</h2>
            <div class="max-w-4xl mx-auto">
                <!-- Timeline -->
                <ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical">
                    
                    <% experience.forEach(function(position, index) { %><li>
                        <hr class="bg-slate-300"/>
                        <div class="timeline-middle">
                            <div class="timeline-marker bg-transparent">
                                <i class="fas <%= position.icon %> text-slate-600"></i>
                            </div>
                        </div>
                        <div class="<% if(index % 2 === 0) { %>timeline-start<% } else { %>timeline-end<% } %> md:text-end mb-10">
                            <div class="badge badge-neutral mb-2"><%= position.from %> - <%= position.to %></div>
                            <div class="text-lg font-black"><%= position.company %></div>
                            <div class="text-base-content/70 mb-3"><%= position.location %></div>
                            <div class="text-sm text-base-content/60 mb-3"><%= position.description %></div>

                            <% if(typeof position.stages !== 'undefined' && position.stages) { position.stages.forEach(function(stage) { %>
                            <div class="mt-4 p-4 <% if(typeof position.style !== 'undefined' && position.style) { %> <%= position.style %> <% } %> <% if(index % 2 === 0) { %>pr-4 border-r-4<% } else { %>pl-4 border-l-4<% } %>">
                                <% if(typeof stage.from !== 'undefined' && typeof stage.to !== 'undefined' && stage.from && stage.to) { %><div class="badge experience-badge-yandex-senior mb-2"><%= stage.from %> - <%= stage.to %></div><% } %>
                                <div class="text-md font-semibold"><%= stage.title %></div>
                                <div class="text-sm text-base-content/60 mb-2"><%= stage.subtitle %></div>
                                <ul class="text-sm space-y-1 text-base-content/80<% if(index % 2 === 0) { %> text-left<% } %>"><% stage.achievements.forEach(function(achievement) { %>
                                    <li>• <%= achievement %></li><%});%>
                                </ul>
                            </div>                     
<%}); }%>
                        </div>
                        <hr class="bg-slate-300"/>
                    </li><%});%>

                    <!-- Education Marker -->
                    <li>
                        <hr class="bg-slate-300"/>
                        <div class="timeline-middle">
                            <div class="timeline-marker bg-transparent">
                                <i class="fas fa-graduation-cap text-indigo-600"></i>
                            </div>
                        </div>
                        <div class="timeline-end mb-10">
                            <div class="badge badge-neutral mb-2">2014 - 2016</div>
                            <div class="text-lg font-black">Master of Science</div>
                            <div class="text-base-content/70 mb-3">ITMO University · St. Petersburg, Russia</div>
                            <div class="text-sm text-base-content/60">Laser Engineering and Laser Technologies</div>
                        </div>
                    </li>
                    
                </ul>
            </div>
        </div>
    </section>

    <!-- Career Goals Section -->
    <% if(typeof career_focus !== 'undefined' && career_focus) {%>
    <section class="py-16 bg-base-200">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="text-3xl font-bold mb-8 text-base-content">Career Focus</h2>
                <div class="card bg-base-100 shadow-xl">
                    <div class="card-body">
                        <div class="flex items-center justify-center mb-4">
                            <div class="btn btn-circle btn-primary mr-4">
                                <i class="fas <%= career_focus.icon %> text-xl"></i>
                            </div>
                            <h3 class="text-xl font-bold"><%= career_focus.title %></h3>
                        </div>
                        <p class="text-base-content/80 leading-relaxed">
                            <%= career_focus.description %>
                        </p>
                        <div class="flex flex-wrap justify-center gap-2 mt-6"><% career_focus.badges.forEach(function(badge) { %>
                            <div class="badge badge-<%= badge.style %> badge-outline"><%= badge.label %></div>
                        <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <%}%>

    <!-- Contact Section -->
    <section id="contact" class="py-20 bg-base-100">
        <% if(typeof contacts !== 'undefined' && contacts) { %>
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16 text-base-content">Contact</h2>
            <div class="max-w-4xl mx-auto">
                <div class="grid md:grid-cols-2 gap-12">
                    <div class="space-y-8">
                        <div class="flex items-center space-x-4">
                            <div class="btn btn-circle btn-success">
                                <i class="fas fa-file-pdf text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-base-content">Resume</h3>
                                <p class="text-base-content/70">
                                    <a href="{{@custom.resume_link}}" target="_blank" class="link link-hover">Download PDF Resume</a>
                                </p>
                            </div>
                        </div>
                        <% if(contacts.email) { %>
                        <div class="flex items-center space-x-4">
                            <div class="btn btn-circle btn-primary">
                                <i class="fas fa-envelope text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-base-content">Email</h3>
                                <p class="text-base-content/70">
                                    <a href="mailto:<%= contacts.email %>" class="link link-hover" target="_blank"><%= contacts.email %></a>
                                </p>
                            </div>
                        </div><%}%>
                        <% if(contacts.linkedin) { %>
                        <div class="flex items-center space-x-4">
                            <div class="btn btn-circle btn-secondary">
                                <i class="fab fa-linkedin text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-base-content">LinkedIn</h3>
                                <p class="text-base-content/70">
                                    <a href="https://<%= contacts.linkedin %>" class="link link-hover" target="_blank"><%= contacts.linkedin %></a>
                                </p>
                            </div>
                        </div><%}%>
                        <% if(contacts.github) { %>
                        <div class="flex items-center space-x-4">
                            <div class="btn btn-circle btn-accent">
                                <i class="fab fa-github text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-base-content">GitHub</h3>
                                <p class="text-base-content/70">
                                    <a href="https://<%= contacts.github %>" class="link link-hover" target="_blank"><%= contacts.github %></a>
                                </p>
                            </div>
                        </div>
                        <%}%>
                        <% if(contacts.location) { %>
                        <div class="flex items-center space-x-4">
                            <div class="btn btn-circle btn-warning">
                                <i class="fas fa-map-marker-alt text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-semibold text-base-content">Location</h3>
                                <p class="text-base-content/70"><%= contacts.location %></p>
                            </div>
                        </div><%}%>
                    </div>
                    <div class="card bg-base-200 shadow-xl">
                        <div class="card-body">
                            <h3 class="card-title mb-4">Get in Touch</h3>
                            <form class="space-y-4" action="{{@custom.formspree_endpoint}}" method="POST">
                                <div class="form-control">
                                    <input name="name" type="text" placeholder="Your Name" class="input input-bordered" required />
                                </div>
                                <div class="form-control">
                                    <input name="email" type="email" placeholder="Email" class="input input-bordered" required />
                                </div>
                                <div class="form-control">
                                    <textarea name="message" class="textarea textarea-bordered h-32" placeholder="Message" required></textarea>
                                </div>
                                <div class="form-control">
                                    <button type="submit" class="btn btn-primary">Send Message</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </section>

    {{> footer}}

    <script>
        // Theme toggle functionality
        const themeToggle = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-icon');
        const html = document.documentElement;

        // Load saved theme or default to light
        const currentTheme = localStorage.getItem('theme') || 'light';
        html.setAttribute('data-theme', currentTheme);
        
        if (themeIcon) {
            updateThemeIcon(currentTheme);
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                if (themeIcon) {
                    updateThemeIcon(newTheme);
                }
            });
        }

        function updateThemeIcon(theme) {
            if (themeIcon) {
                if (theme === 'dark') {
                    themeIcon.className = 'fas fa-sun text-xl';
                } else {
                    themeIcon.className = 'fas fa-moon text-xl';
                }
            }
        }

        // Mobile menu functionality
        function closeMobileMenu() {
            // Remove focus from dropdown toggle to close the menu
            const dropdownToggle = document.querySelector('.dropdown [tabindex="0"]');
            if (dropdownToggle) {
                dropdownToggle.blur();
            }
            // Also remove focus from any focused element
            if (document.activeElement) {
                document.activeElement.blur();
            }
        }

        // Close mobile menu when clicking on navigation links
        document.querySelectorAll('.dropdown .menu a').forEach(link => {
            link.addEventListener('click', function() {
                // Small delay to ensure the action completes before closing
                setTimeout(closeMobileMenu, 100);
            });
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(e) {
            const dropdown = document.querySelector('.dropdown');
            const dropdownToggle = document.querySelector('.dropdown [tabindex="0"]');
            
            // Don't close if clicking on form elements
            if (e.target.matches('input, textarea, button[type="submit"], .form-control, .form-control *')) {
                return;
            }
            
            if (dropdown && !dropdown.contains(e.target)) {
                closeMobileMenu();
            }
        });

        // Close mobile menu on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeMobileMenu();
            }
        });

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>



    {{!-- Ghost foot --}}
    {{ghost_foot}}
</body>
</html>
